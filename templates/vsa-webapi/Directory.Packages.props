<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <IncludeWolverineRuntimeCompilation
      Condition="'$(IncludeWolverineRuntimeCompilation)' == ''">true</IncludeWolverineRuntimeCompilation>
  </PropertyGroup>
  <ItemGroup>
    <!-- Wolverine -->
    <PackageVersion Include="WolverineFx" Version="6.51.1" />
    <PackageVersion Include="WolverineFx.FluentValidation" Version="6.51.1" />
    <PackageVersion Include="WolverineFx.Http" Version="6.51.1" />
    <PackageVersion Include="WolverineFx.Http.FluentValidation" Version="6.51.1" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.51.1" />
    <PackageVersion
      Include="Microsoft.CodeAnalysis.Workspaces.MSBuild"
      Version="5.0.0"
      Condition="'$(IncludeWolverineRuntimeCompilation)' == 'true'" />

    <!-- Mapping -->
    <PackageVersion Include="Mapster" Version="10.0.13" />
    <PackageVersion Include="Mapster.DependencyInjection" Version="10.0.13" />

    <!-- Validation -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />

    <!-- EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13" />
    <!--#if (DB_POSTGRESQL) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--#endif -->
    <!--#if (DB_SQLSERVER) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!--#endif -->
    <!--#if (DB_SQLITE) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!--#endif -->

    <!-- API Docs -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    <!--#if (APIDOCS_SCALAR) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.0" />
    <!--#endif -->
    <!--#if (APIDOCS_SWAGGER) -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <!--#endif -->

    <!-- Auth -->
    <!--#if (AUTH_ENABLED) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <!--#endif -->
    <!--#if (AUTH_IDENTITY) -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <!--#endif -->

    <!-- Observability -->
    <!--#if (OTEL_ENABLED) -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <!--#endif -->

    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Misc -->
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <!--#if (DOCKER_ENABLED) -->

    <!-- Visual Studio Container Tools (Docker Compose debugging) -->
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <!--#endif -->
    <!--#if (DB_SQLSERVER) -->

    <!-- Security: Microsoft.Data.SqlClient requests System.Security.Cryptography.Pkcs 9.0.11,
         affected by CVE-2026-84008 and CVE-2026-70162. Transitive pinning lifts it to the fix. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!--#endif -->
  </ItemGroup>
</Project>
