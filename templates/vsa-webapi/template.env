# ---------------------------------------------------------------------------
# Single source of configuration for Docker Compose and Visual Studio (F5).
#
# - Compose reads this file to fill ${...} values in docker-compose*.yml.
# - Every entry is also passed to the api container. Names written as
#   Section__Key override appsettings*.json (for example Jwt__SecretKey
#   replaces "Jwt": { "SecretKey" }).
# - This file is git-ignored. Keep production secrets out of source control
#   and supply a separate file on the server.
# - A literal "$" in a value must be written as "$$".
# ---------------------------------------------------------------------------

# API
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
BUILD_CONFIGURATION=Debug
APP_HTTP_PORT=8080
APP_IMAGE_TAG=latest
Cors__AllowedOrigins__0=http://localhost:3000
# Apply pending EF Core migrations when the api starts (create them with
# `dotnet ef migrations add <Name> -o Data/Migrations`).
Database__MigrateOnStartup=true
#if (DOCKER_POSTGRES)

# PostgreSQL
POSTGRES_TAG=17-alpine
POSTGRES_DB=vsa_compose_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
#endif
#if (DOCKER_SQLSERVER)

# SQL Server (the password must meet SQL Server complexity rules)
MSSQL_TAG=2022-latest
MSSQL_PID=Developer
MSSQL_DB=vsa_compose_db
MSSQL_SA_PASSWORD=Dev_Passw0rd!
MSSQL_PORT=1433
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=${MSSQL_DB};User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;Encrypt=False
#endif
#if (DOCKER_SQLITE)

# SQLite (stored in the sqlite-data volume)
ConnectionStrings__DefaultConnection=Data Source=/app/data/app.db
#endif
#if (AUTH_KEYCLOAK)

# Keycloak
Keycloak__BaseUrl=https://localhost:8080
Keycloak__Realm=myrealm
Keycloak__Issuer=https://localhost:8080/realms/myrealm
Keycloak__InternalIssuer=https://localhost:8080/realms/myrealm
Keycloak__Audience=account
#endif
#if (AUTH_IDENTITY)

# JWT (the signing key needs at least 32 characters)
Jwt__Issuer=https://localhost:5001
Jwt__Audience=vsa-webapi
Jwt__SecretKey=CHANGE_ME_this_is_a_minimum_32_character_secret_key_for_dev_only
#endif
#if (DOCKER_ASPIRE)

# Aspire Dashboard
ASPIRE_DASHBOARD_TAG=13.0
ASPIRE_DASHBOARD_PORT=18888
ASPIRE_OTLP_PORT=18889
ASPIRE_OTLP_API_KEY=change-me
# true opens the dashboard without a login token (local development only).
ASPIRE_ALLOW_ANONYMOUS=true

# OpenTelemetry export from the api to the dashboard
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=x-otlp-api-key=${ASPIRE_OTLP_API_KEY}
OTEL_SERVICE_NAME=VsaTemplate
OTEL_RESOURCE_ATTRIBUTES=service.namespace=VsaTemplate
#endif
