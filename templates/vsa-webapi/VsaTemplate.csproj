<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VsaTemplate</RootNamespace>
    <DbProvider>__DB_PROVIDER__</DbProvider>
    <ApiDocsTool>__APIDOCS_TOOL__</ApiDocsTool>
    <CacheTool>__CACHE_TOOL__</CacheTool>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DbProvider)' == 'PostgreSQL' Or '$(DbProvider)' == '__DB_PROVIDER__'">
    <DefineConstants>$(DefineConstants);DB_POSTGRESQL</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DbProvider)' == 'SqlServer'">
    <DefineConstants>$(DefineConstants);DB_SQLSERVER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DbProvider)' == 'Sqlite'">
    <DefineConstants>$(DefineConstants);DB_SQLITE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ApiDocsTool)' == 'Scalar' Or '$(ApiDocsTool)' == '__APIDOCS_TOOL__'">
    <DefineConstants>$(DefineConstants);APIDOCS_SCALAR</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ApiDocsTool)' == 'Swagger'">
    <DefineConstants>$(DefineConstants);APIDOCS_SWAGGER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CacheTool)' == 'OutputCache' Or '$(CacheTool)' == '__CACHE_TOOL__'">
    <DefineConstants>$(DefineConstants);CACHE_OUTPUT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" Version="5.*" />
    <PackageReference Include="WolverineFx.FluentValidation" Version="5.*" />
    <PackageReference Include="WolverineFx.Http" Version="5.*" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" Version="5.*" />
    <PackageReference Include="Mapster" Version="7.*" />
    <PackageReference Include="Mapster.DependencyInjection" Version="1.*" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="9.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.*" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(DbProvider)' == 'PostgreSQL' Or '$(DbProvider)' == '__DB_PROVIDER__'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(DbProvider)' == 'SqlServer'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(DbProvider)' == 'Sqlite'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(ApiDocsTool)' == 'Scalar' Or '$(ApiDocsTool)' == '__APIDOCS_TOOL__'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(ApiDocsTool)' == 'Swagger'">
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.*" />
  </ItemGroup>

</Project>
