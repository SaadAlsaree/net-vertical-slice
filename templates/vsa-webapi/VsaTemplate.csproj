<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VsaTemplate</RootNamespace>
    <DbProvider>__DB_PROVIDER__</DbProvider>
    <ApiDocsTool>__APIDOCS_TOOL__</ApiDocsTool>
    <CacheTool>__CACHE_TOOL__</CacheTool>
    <AuthProvider>__AUTH_PROVIDER__</AuthProvider>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DbProvider)' == 'PostgreSQL' Or '$(DbProvider)' == '__DB_PROVIDER__'">
    <DefineConstants>$(DefineConstants);DB_POSTGRESQL</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DbProvider)' == 'SqlServer'">
    <DefineConstants>$(DefineConstants);DB_SQLSERVER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DbProvider)' == 'Sqlite'">
    <DefineConstants>$(DefineConstants);DB_SQLITE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ApiDocsTool)' == 'Scalar' Or '$(ApiDocsTool)' == '__APIDOCS_TOOL__'">
    <DefineConstants>$(DefineConstants);APIDOCS_SCALAR</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ApiDocsTool)' == 'Swagger'">
    <DefineConstants>$(DefineConstants);APIDOCS_SWAGGER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CacheTool)' == 'OutputCache' Or '$(CacheTool)' == '__CACHE_TOOL__'">
    <DefineConstants>$(DefineConstants);CACHE_OUTPUT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AuthProvider)' == 'Keycloak'">
    <DefineConstants>$(DefineConstants);AUTH_KEYCLOAK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.FluentValidation" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" />
    <PackageReference Include="Mapster" />
    <PackageReference Include="Mapster.DependencyInjection" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
  </ItemGroup>

  <ItemGroup Condition="'$(DbProvider)' == 'PostgreSQL' Or '$(DbProvider)' == '__DB_PROVIDER__'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup Condition="'$(DbProvider)' == 'SqlServer'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup Condition="'$(DbProvider)' == 'Sqlite'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup Condition="'$(ApiDocsTool)' == 'Scalar' Or '$(ApiDocsTool)' == '__APIDOCS_TOOL__'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup Condition="'$(ApiDocsTool)' == 'Swagger'">
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup Condition="'$(AuthProvider)' == 'Keycloak'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
