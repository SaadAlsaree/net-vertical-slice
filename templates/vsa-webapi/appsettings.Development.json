{
  "ConnectionStrings": {
    "DefaultConnection": "__DEV_CONNECTION_STRING__"
  },
  //#if (AUTH_KEYCLOAK)
  "Keycloak": {
    "BaseUrl": "https://localhost:8080",
    "Realm": "myrealm",
    "Issuer": "https://localhost:8080/realms/myrealm",
    "InternalIssuer": "https://localhost:8080/realms/myrealm",
    "Audience": "account"
  },
  //#endif
  //#if (AUTH_IDENTITY)
  "Jwt": {
    "Issuer": "https://localhost:5001",
    "Audience": "vsa-webapi",
    "SecretKey": "CHANGE_ME_this_is_a_minimum_32_character_secret_key_for_dev_only",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  //#endif
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  }
}
