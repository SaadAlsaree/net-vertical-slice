{
  "ConnectionStrings": {
    "DefaultConnection": "__CONNECTION_STRING__"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  //#if (AUTH_KEYCLOAK)
  "Keycloak": {
    "BaseUrl": "https://localhost:8080",
    "Realm": "myrealm",
    "Issuer": "https://localhost:8080/realms/myrealm",
    "InternalIssuer": "https://localhost:8080/realms/myrealm",
    "Audience": "account"
  },
  //#endif
  //#if (AUTH_IDENTITY)
  "Jwt": {
    "Issuer": "https://localhost:5001",
    "Audience": "vsa-webapi",
    "SecretKey": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  //#endif
  "RateLimiting": {
    "Authenticated": {
      "TokenLimit": 60,
      "TokensPerPeriod": 10,
      "ReplenishmentPeriodSeconds": 10
    },
    "Anonymous": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 300,
      "SegmentsPerWindow": 5
    },
    "Registration": {
      "PermitLimit": 5,
      "WindowSeconds": 900,
      "SegmentsPerWindow": 5
    },
    "RefreshToken": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
