{
  "ConnectionStrings": {
    "DefaultConnection": "__CONNECTION_STRING__"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "BaseUrl": "https://localhost:8080",
    "Realm": "myrealm",
    "ClientId": "",
    "AdminClientId": "",
    "AdminClientSecret": "",
    "Issuer": "https://localhost:8080/realms/myrealm",
    "InternalIssuer": "https://localhost:8080/realms/myrealm",
    "Audience": "",
    "WebhookSecret": "",
    "UseInternalUrlsForAdmin": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
