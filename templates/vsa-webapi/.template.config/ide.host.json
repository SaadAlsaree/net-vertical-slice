{
  "$schema": "https://json.schemastore.org/ide.host",
  "order": 200,
  "icon": "ide/icon.ico",
  "symbolInfo": [
    {
      "id": "DbProvider",
      "name": {
        "text": "Database Type"
      },
      "description": {
        "text": "Choose the database provider used by Entity Framework Core."
      },
      "isVisible": true,
      "choices": [
        {
          "id": "PostgreSQL",
          "name": {
            "text": "PostgreSQL"
          },
          "description": {
            "text": "Use Npgsql for PostgreSQL."
          }
        },
        {
          "id": "SqlServer",
          "name": {
            "text": "SQL Server"
          },
          "description": {
            "text": "Use Microsoft SQL Server provider."
          }
        },
        {
          "id": "Sqlite",
          "name": {
            "text": "SQLite"
          },
          "description": {
            "text": "Use SQLite for local or lightweight storage."
          }
        }
      ]
    },
    {
      "id": "ApiDocsTool",
      "name": {
        "text": "API Documentation"
      },
      "description": {
        "text": "Choose which API docs UI to generate."
      },
      "isVisible": true,
      "choices": [
        {
          "id": "Swagger",
          "name": {
            "text": "Swagger"
          },
          "description": {
            "text": "Generate Swagger UI with Swashbuckle."
          }
        },
        {
          "id": "Scalar",
          "name": {
            "text": "Scalar"
          },
          "description": {
            "text": "Generate Scalar API Reference UI."
          }
        }
      ]
    },
    {
      "id": "CacheTool",
      "name": {
        "text": "Caching"
      },
      "description": {
        "text": "Choose whether to enable output caching middleware."
      },
      "isVisible": true,
      "choices": [
        {
          "id": "OutputCache",
          "name": {
            "text": "Output Cache"
          },
          "description": {
            "text": "Enable ASP.NET Core output caching for GET endpoints."
          }
        },
        {
          "id": "None",
          "name": {
            "text": "No Cache"
          },
          "description": {
            "text": "Do not configure output caching middleware."
          }
        }
      ]
    },
    {
      "id": "AuthProvider",
      "name": {
        "text": "Authentication"
      },
      "description": {
        "text": "Choose the authentication provider for securing the API."
      },
      "isVisible": true,
      "choices": [
        {
          "id": "None",
          "name": {
            "text": "No Authentication"
          },
          "description": {
            "text": "Do not configure authentication."
          }
        },
        {
          "id": "Keycloak",
          "name": {
            "text": "Keycloak"
          },
          "description": {
            "text": "Configure JWT Bearer authentication with Keycloak."
          }
        },
        {
          "id": "Identity",
          "name": {
            "text": "ASP.NET Core Identity"
          },
          "description": {
            "text": "Local ASP.NET Core Identity with JWT Bearer authentication, including login/register/refresh/logout endpoints."
          }
        }
      ]
    },
    {
      "id": "Observability",
      "name": {
        "text": "Observability"
      },
      "description": {
        "text": "Choose whether to export ASP.NET Core and Wolverine traces, metrics, and logs through OpenTelemetry."
      },
      "isVisible": true,
      "choices": [
        {
          "id": "None",
          "name": {
            "text": "No Telemetry"
          },
          "description": {
            "text": "Do not add an observability exporter."
          }
        },
        {
          "id": "OpenTelemetry",
          "name": {
            "text": "OpenTelemetry"
          },
          "description": {
            "text": "Export traces, metrics, and logs through the OTLP protocol."
          }
        }
      ]
    },
    {
      "id": "Docker",
      "name": {
        "text": "Docker Compose"
      },
      "description": {
        "text": "Generate a Dockerfile, docker-compose.yml with the selected database, and an Aspire Dashboard service when OpenTelemetry is selected."
      },
      "isVisible": true
    }
  ]
}
