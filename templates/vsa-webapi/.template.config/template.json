{
  "$schema": "http://json.schemastore.org/template",
  "author": "net-vertical-slice",
  "classifications": ["Web", "WebAPI", "API", "Wolverine", "CQRS", "VSA"],
  "identity": "NetVerticalSlice.WebApi",
  "name": "Wolverine VSA Web API",
  "shortName": "vsa-webapi",
  "description": "Creates a new ASP.NET Core Web API project pre-configured with Wolverine CQRS, Vertical Slice Architecture, EF Core, FluentValidation, and Mapster. Includes all infrastructure boilerplate (Response<T>, Result<T>, Error, PagedList<T>, BaseEntity, GlobalExceptionHandler) and a sample feature.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "VsaTemplate",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "net10.0", "description": ".NET 10 LTS" }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    },
    "DbProvider": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "PostgreSQL", "description": "Npgsql PostgreSQL" },
        { "choice": "SqlServer", "description": "Microsoft SQL Server" },
        { "choice": "Sqlite", "description": "SQLite" }
      ],
      "defaultValue": "PostgreSQL",
      "description": "Database provider",
      "replaces": "__DB_PROVIDER__"
    },
    "ApiDocsTool": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "Scalar", "description": "Scalar API documentation" },
        { "choice": "Swagger", "description": "Swagger / Swashbuckle" }
      ],
      "defaultValue": "Scalar",
      "description": "API documentation tool",
      "replaces": "__APIDOCS_TOOL__"
    },
    "CacheTool": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "OutputCache", "description": "Enable ASP.NET Core output caching middleware" },
        { "choice": "None", "description": "Disable output caching" }
      ],
      "defaultValue": "OutputCache",
      "description": "Caching option",
      "replaces": "__CACHE_TOOL__"
    },
    "AuthProvider": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "None", "description": "No authentication provider" },
        { "choice": "Keycloak", "description": "Keycloak JWT Bearer authentication" },
        { "choice": "Identity", "description": "ASP.NET Core Identity with local JWT Bearer authentication" }
      ],
      "defaultValue": "None",
      "description": "Authentication provider",
      "replaces": "__AUTH_PROVIDER__"
    },
    "Observability": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "None", "description": "No telemetry exporter" },
        { "choice": "OpenTelemetry", "description": "OpenTelemetry traces, metrics, and logs through OTLP" }
      ],
      "defaultValue": "None",
      "description": "Application observability",
      "replaces": "__OBSERVABILITY__"
    },
    "Docker": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Generate Dockerfile, Docker Compose, and a .env configuration file for containerized development"
    },
    "DB_POSTGRESQL": {
      "type": "computed",
      "value": "(DbProvider == \"PostgreSQL\")"
    },
    "DB_SQLSERVER": {
      "type": "computed",
      "value": "(DbProvider == \"SqlServer\")"
    },
    "DB_SQLITE": {
      "type": "computed",
      "value": "(DbProvider == \"Sqlite\")"
    },
    "APIDOCS_SWAGGER": {
      "type": "computed",
      "value": "(ApiDocsTool == \"Swagger\")"
    },
    "APIDOCS_SCALAR": {
      "type": "computed",
      "value": "(ApiDocsTool == \"Scalar\")"
    },
    "CACHE_OUTPUT": {
      "type": "computed",
      "value": "(CacheTool == \"OutputCache\")"
    },
    "AUTH_KEYCLOAK": {
      "type": "computed",
      "value": "(AuthProvider == \"Keycloak\")"
    },
    "AUTH_IDENTITY": {
      "type": "computed",
      "value": "(AuthProvider == \"Identity\")"
    },
    "AUTH_ENABLED": {
      "type": "computed",
      "value": "(AuthProvider == \"Keycloak\" || AuthProvider == \"Identity\")"
    },
    "OTEL_ENABLED": {
      "type": "computed",
      "value": "(Observability == \"OpenTelemetry\")"
    },
    "DOCKER_ENABLED": {
      "type": "computed",
      "value": "(Docker)"
    },
    "DOCKER_POSTGRES": {
      "type": "computed",
      "value": "(Docker && DbProvider == \"PostgreSQL\")"
    },
    "DOCKER_SQLSERVER": {
      "type": "computed",
      "value": "(Docker && DbProvider == \"SqlServer\")"
    },
    "DOCKER_SQLITE": {
      "type": "computed",
      "value": "(Docker && DbProvider == \"Sqlite\")"
    },
    "DOCKER_ASPIRE": {
      "type": "computed",
      "value": "(Docker && Observability == \"OpenTelemetry\")"
    },
    "ProjectFileName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "csprojFileName",
      "replaces": "VsaTemplate.csproj"
    },
    "AssemblyFileName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "dllFileName",
      "replaces": "VsaTemplate.dll"
    },
    "HostIdentifier": {
      "type": "bind",
      "binding": "HostIdentifier"
    },
    "ComposeProjectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "composeName",
      "replaces": "vsa-compose-name"
    },
    "ComposeDatabaseName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "databaseName",
      "replaces": "vsa_compose_db"
    },
    "ApiDocsLaunchUrl": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__APIDOCS_LAUNCH_URL__",
      "parameters": {
        "cases": [
          {
            "condition": "(ApiDocsTool == \"Swagger\")",
            "value": "swagger"
          },
          {
            "condition": "(ApiDocsTool == \"Scalar\")",
            "value": "scalar/v1"
          }
        ]
      }
    },
    "ApiDocsLaunchBrowser": {
      "type": "generated",
      "generator": "switch",
      "replaces": "\"launchBrowser\": false",
      "parameters": {
        "cases": [
          {
            "condition": "(ApiDocsTool == \"Swagger\")",
            "value": "\"launchBrowser\": true"
          },
          {
            "condition": "(ApiDocsTool == \"Scalar\")",
            "value": "\"launchBrowser\": true"
          }
        ]
      }
    },
    "DefaultConnectionString": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__CONNECTION_STRING__",
      "parameters": {
        "cases": [
          {
            "condition": "(DbProvider == \"PostgreSQL\")",
            "value": "Host=localhost;Port=5432;Database=vsatemplate_db;Username=postgres;Password=postgres"
          },
          {
            "condition": "(DbProvider == \"SqlServer\")",
            "value": "Server=localhost,1433;Database=vsatemplate_db;User Id=sa;Password=Your_password123;TrustServerCertificate=True"
          },
          {
            "condition": "(DbProvider == \"Sqlite\")",
            "value": "Data Source=vsatemplate.db"
          }
        ]
      }
    },
    "DevelopmentConnectionString": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__DEV_CONNECTION_STRING__",
      "parameters": {
        "cases": [
          {
            "condition": "(DbProvider == \"PostgreSQL\")",
            "value": "Host=localhost;Port=5432;Database=vsatemplate_dev;Username=postgres;Password=postgres"
          },
          {
            "condition": "(DbProvider == \"SqlServer\")",
            "value": "Server=localhost,1433;Database=vsatemplate_dev;User Id=sa;Password=Your_password123;TrustServerCertificate=True"
          },
          {
            "condition": "(DbProvider == \"Sqlite\")",
            "value": "Data Source=vsatemplate_dev.db"
          }
        ]
      }
    }
  },
  "specialCustomOperations": {
    "**/docker-compose*.yml": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "#if" ],
            "else": [ "#else" ],
            "elseif": [ "#elseif", "#elif" ],
            "endif": [ "#endif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/template.env": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "#if" ],
            "else": [ "#else" ],
            "elseif": [ "#elseif", "#elif" ],
            "endif": [ "#endif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif", "<!--#elif" ],
            "endif": [ "<!--#endif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/Dockerfile": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "#if" ],
            "else": [ "#else" ],
            "elseif": [ "#elseif", "#elif" ],
            "endif": [ "#endif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  "forms": {
    "lowerInvariant": {
      "identifier": "lowerCaseInvariant"
    },
    "nonAlphanumericToDash": {
      "identifier": "replace",
      "pattern": "[^a-z0-9]+",
      "replacement": "-"
    },
    "nonAlphanumericToUnderscore": {
      "identifier": "replace",
      "pattern": "[^a-z0-9]+",
      "replacement": "_"
    },
    "csprojFileName": {
      "identifier": "replace",
      "pattern": "^(.*)$",
      "replacement": "$1.csproj"
    },
    "dllFileName": {
      "identifier": "replace",
      "pattern": "^(.*)$",
      "replacement": "$1.dll"
    },
    "composeName": {
      "identifier": "chain",
      "steps": [ "lowerInvariant", "nonAlphanumericToDash" ]
    },
    "databaseName": {
      "identifier": "chain",
      "steps": [ "lowerInvariant", "nonAlphanumericToUnderscore" ]
    }
  },
  "guids": [
    "6F0C2D7A-3B4E-4C1A-9E58-2A7B1D4C8E90"
  ],
  "primaryOutputs": [
    { "path": "VsaTemplate.csproj" },
    {
      "condition": "(DOCKER_ENABLED)",
      "path": "docker-compose/docker-compose.dcproj"
    }
  ],
  "sources": [
    {
      "rename": {
        "template.env": ".env"
      },
      "modifiers": [
        {
          "condition": "(!AUTH_ENABLED)",
          "exclude": [
            "Extensions/AuthClaims.cs",
            "Extensions/CurrentUserExtensions.cs",
            "Models/CurrentUser.cs"
          ]
        },
        {
          "condition": "(HostIdentifier == \"vs\")",
          "exclude": [
            "VsaTemplate.slnx"
          ]
        },
        {
          "condition": "(!DOCKER_ENABLED)",
          "exclude": [
            "Dockerfile",
            ".dockerignore",
            "docker-compose.yml",
            "docker-compose.override.yml",
            "docker-compose/**",
            "template.env"
          ]
        },
        {
          "condition": "(!AUTH_KEYCLOAK)",
          "exclude": [
            "DependencyInjection/KeycloakAuthenticationExtensions.cs",
            "Models/KeycloakSettings.cs"
          ]
        },
        {
          "condition": "(!AUTH_IDENTITY)",
          "exclude": [
            "DependencyInjection/IdentityAuthenticationExtensions.cs",
            "Data/Configuration/RefreshTokenConfiguration.cs",
            "Data/Entities/ApplicationUser.cs",
            "Data/Entities/RefreshToken.cs",
            "Features/AuthFeature/**",
            "Infrastructure/Authentication/**",
            "Models/JwtSettings.cs"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages",
      "manualInstructions": [
        { "text": "Run 'dotnet restore'" }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
