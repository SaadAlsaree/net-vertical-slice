<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <PackageType>Template</PackageType>
    <PackageId>NetVerticalSlice.Templates</PackageId>
    <Version>2.1.0</Version>
    <Title>Net Vertical Slice Templates</Title>
    <Authors>SaadAlsaree</Authors>
    <Company>SaadAlsaree</Company>
    <Product>Net Vertical Slice Templates</Product>
    <Description>Production-oriented ASP.NET Core project and item templates built with Wolverine CQRS, Vertical Slice Architecture (VSA), EF Core, FluentValidation, and Mapster.</Description>
    <PackageTags>dotnet-new;template;webapi;vsa;wolverine;cqrs;vertical-slice-architecture;aspnetcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SaadAlsaree/net-vertical-slice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/SaadAlsaree/net-vertical-slice</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v2.1.0 ships a single .slnx solution, an opt-in Docker / Docker Compose setup that adapts to the selected database, an Aspire Dashboard service wired to OpenTelemetry over OTLP, and central package pinning limited to the selected options.</PackageReleaseNotes>

    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="vsa-webapi\**\*"
             Exclude="vsa-webapi\bin\**;vsa-webapi\obj\**;vsa-webapi\.vs\**;vsa-webapi\**\bin\**;vsa-webapi\**\obj\**;vsa-webapi\SKILL.md;vsa-webapi\*.user;vsa-webapi\**\*.sln" />
    <Content Include="vsa-feature\**\*"
             Exclude="vsa-feature\bin\**;vsa-feature\obj\**;vsa-feature\**\bin\**;vsa-feature\**\obj\**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
